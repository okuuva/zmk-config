#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#ifdef CONFIG_WIRELESS
  #include <dt-bindings/zmk/bt.h>
  #include <dt-bindings/zmk/outputs.h>
#endif

#include "zmk-helpers/helper.h"

#define BASE 0
#define NAV 1
#define NUM 2
#define SYM 3
#define FN 4
#define MOUSE 5

#define XXX &none
#define ___ &trans

/* Global defaults */

#define QUICK_TAP_MS 175

&sk {
  release-after-ms = <900>;
  quick-release;
};

&sl { // Allow sticky mods to chord across sticky layers.
  ignore-modifiers;
};

&lt {
  flavor = "balanced";
  tapping-term-ms = <200>;
  quick-tap-ms = <QUICK_TAP_MS>;
};

/* Homerow mods */

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R RT0 RT1 RT2 RT3 RT4 LT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2 // Thumbs on 36+ keys.

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS)                                 \
  ZMK_HOLD_TAP(NAME, bindings = <HOLD>, <TAP>; flavor = "balanced";            \
               tapping-term-ms = <280>; quick-tap-ms = <QUICK_TAP_MS>;         \
               require-prior-idle-ms = <150>; hold-trigger-on-release;         \
               hold-trigger-key-positions = <TRIGGER_POS>;)

MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS) // Left-hand HRMs.
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS) // Right-hand HRMs.

#include "mouse.dtsi"

/* Keymap */

/ {
   keymap {
       compatible = "zmk,keymap";

       base_layer {
           display-name = "Base";
           bindings = <
//    ┌────────────┬─────────────┬─────────────┬─────────────┬─────────────┬──────────────┐                         ┌──────────┬─────────────┬─────────────┬─────────────┬─────────────┬─────┐
//    │   mo FN    │      Q      │      Y      │      O      │      U      │      ;       │                         │    X     │      L      │      D      │      O      │      Z      │     │
//    ├────────────┼─────────────┼─────────────┼─────────────┼─────────────┼──────────────┤                         ├──────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────┤
//    │ lt MOUSE B │ &hml lctl C │ &hml lalt I │ &hml lsft E │ &hml lgui A │      ,       │                         │    K     │ &hmr rgui H │ &hmr rsft T │ &hmr ralt N │ &hmr rctl S │  V  │
//    ├────────────┼─────────────┼─────────────┼─────────────┼─────────────┼──────────────┤                         ├──────────┼─────────────┼─────────────┼─────────────┼─────────────┼─────┤
//    │     ä      │      Z      │      X      │      C      │      V      │      .       │                         │    J     │      M      │      G      │      P      │      F      │     │
//    └────────────┴─────────────┴─────────────┴─────────────┼─────────────┼──────────────┼────────┐   ┌────────────┼──────────┼─────────────┼─────────────┴─────────────┴─────────────┴─────┘
//                                                           │     tab     │ mt hyper spc │ mo NUM │   │ lt SYM esc │ lt NAV R │   mo NAV    │
//                                                           └─────────────┴──────────────┴────────┘   └────────────┴──────────┴─────────────┘
  &mo FN            &kp Q                 &kp Y             &kp O               &kp U         &kp SEMICOLON                                                &kp X       &kp L              &kp D                &kp O              &kp Z                  &none
  &lt MOUSE B       &hml LEFT_CONTROL C   &hml LEFT_ALT I   &hml LEFT_SHIFT E   &hml LCMD A   &kp COMMA                                                    &kp K       &hmr RIGHT_GUI H   &hmr RIGHT_SHIFT T   &hmr RIGHT_ALT N   &hmr RIGHT_CONTROL S   &kp V
  &kp NON_US_BSLH   &kp Z                 &kp X             &kp C               &kp V         &kp PERIOD                                                   &kp J       &kp M              &kp G                &kp P              &kp F                  &none
                                                                                &kp TAB       &mt LS(LA(LC(LEFT_GUI))) SPACE   &mo NUM       &lt SYM ESC   &lt NAV R   &mo NAV
           >;
       };

       nav_layer {
           bindings = <
//    ┌───────────┬─────────────────┬──────────────┬──────────────┬──────────────┬──────┐             ┌────────────┬───────┬──────┬──────┬──────┬────┐
//    │           │                 │   Prev tab   │   New tab    │   Next tab   │      │             │            │ home  │ pgdn │ pgup │ end  │    │
//    ├───────────┼─────────────────┼──────────────┼──────────────┼──────────────┼──────┤             ├────────────┼───────┼──────┼──────┼──────┼────┤
//    │           │      caps       │ Prev desktop │  Switch app  │ Next desktop │      │             │ Fullscreen │ left  │ down │  up  │ rght │    │
//    ├───────────┼─────────────────┼──────────────┼──────────────┼──────────────┼──────┤             ├────────────┼───────┼──────┼──────┼──────┼────┤
//    │ Prev page │ Mission Control │  Next page   │ Close window │              │      │             │   again    │ paste │ copy │ cut  │ undo │    │
//    └───────────┴─────────────────┴──────────────┴──────────────┼──────────────┼──────┼────┐   ┌────┼────────────┼───────┼──────┴──────┴──────┴────┘
//                                                                │              │ bspc │    │   │    │            │       │
//                                                                └──────────────┴──────┴────┘   └────┴────────────┴───────┘
  ___            ___            &kp LA(LG(LEFT))   &kp RG(T)     &kp LA(LG(RIGHT))   ___                        ___             &kp HOME      &kp PG_DN    &kp PG_UP   &kp END      ___
  ___            &kp CAPSLOCK   &kp RC(LEFT)       &kp RG(TAB)   &kp RC(RIGHT)       ___                        &kp LS(LG(F))   &kp LEFT      &kp DOWN     &kp UP      &kp RIGHT    ___
  &kp RG(LEFT)   &kp RC(UP)     &kp RG(RIGHT)      &kp RG(W)     ___                 ___                        &kp K_REDO      &kp K_PASTE   &kp K_COPY   &kp K_CUT   &kp K_UNDO   ___
                                                                 ___                 &kp BSPC   ___       ___   ___             ___
           >;

           label = "Navigation";
       };

       num_layer {
           bindings = <
//    ┌────┬──────┬──────┬──────┬──────┬────┐             ┌────┬────┬───┬───┬─────┬────┐
//    │    │      │      │      │      │    │             │    │ 7  │ 8 │ 9 │     │    │
//    ├────┼──────┼──────┼──────┼──────┼────┤             ├────┼────┼───┼───┼─────┼────┤
//    │    │ lctl │ lalt │ lsft │ lgui │    │             │    │ 4  │ 5 │ 6 │     │    │
//    ├────┼──────┼──────┼──────┼──────┼────┤             ├────┼────┼───┼───┼─────┼────┤
//    │    │      │      │      │      │    │             │    │ 1  │ 2 │ 3 │     │    │
//    └────┴──────┴──────┴──────┼──────┼────┼────┐   ┌────┼────┼────┼───┴───┴─────┴────┘
//                              │      │    │    │   │    │ 0  │    │
//                              └──────┴────┴────┘   └────┴────┴────┘
  ___   ___         ___        ___         ___        ___                   ___      &kp N7   &kp N8   &kp N9   ___     ___
  ___   &kp LCTRL   &kp LALT   &kp LSHFT   &kp LGUI   ___                   ___      &kp N4   &kp N5   &kp N6   &none   ___
  ___   ___         ___        ___         ___        ___                   ___      &kp N1   &kp N2   &kp N3   ___     ___
                                           ___        ___   ___       ___   &kp N0   ___
           >;

           label = "Numbers";
       };

       sym_layer {
           bindings = <
//    ┌───┬───┬───┬───┬───┬───┐            ┌────┬──────┬───────────┬─────┬─────┬────┐
//    │ ` │ { │ ( │ ) │ } │ ? │            │ `  │ del  │ lsft(tab) │  -  │  +  │    │
//    ├───┼───┼───┼───┼───┼───┤            ├────┼──────┼───────────┼─────┼─────┼────┤
//    │ # │ ^ │ = │ _ │ $ │ * │            │ "  │ bspc │    tab    │ ent │ spc │    │
//    ├───┼───┼───┼───┼───┼───┤            ├────┼──────┼───────────┼─────┼─────┼────┤
//    │ & │ ~ │ / │ \ │ | │ . │            │ '  │  [   │     <     │  >  │  ]  │    │
//    └───┴───┴───┴───┼───┼───┼───┐   ┌────┼────┼──────┼───────────┴─────┴─────┴────┘
//                    │ @ │ % │ ! │   │    │    │      │
//                    └───┴───┴───┘   └────┴────┴──────┘
  &kp GRAVE       &kp LEFT_BRACE   &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS   &kp RIGHT_BRACE   &kp QUESTION                               &kp GRAVE           &kp DELETE         &kp LS(TAB)     &kp MINUS          &kp PLUS            ___
  &kp HASH        &kp CARET        &kp EQUAL              &kp UNDERSCORE          &kp DOLLAR        &kp ASTERISK                               &kp DOUBLE_QUOTES   &kp BACKSPACE      &kp TAB         &kp ENTER          &kp SPACE           ___
  &kp AMPERSAND   &kp TILDE        &kp SLASH              &kp BACKSLASH           &kp PIPE          &kp DOT                                    &kp SQT             &kp LEFT_BRACKET   &kp LESS_THAN   &kp GREATER_THAN   &kp RIGHT_BRACKET   ___
                                                                                  &kp AT_SIGN       &kp PERCENT    &kp EXCLAMATION       ___   ___                 ___
           >;

           label = "Symbols";
       };

       fn_layer {
           bindings = <
//    ┌────┬─────┬──────┬──────┬──────┬─────┐              ┌─────┬─────┬────┬────┬─────────┬─────────┐
//    │    │     │      │ bri- │ bri+ │ pwr │              │     │ f7  │ f8 │ f9 │         │ bt_nxt  │
//    ├────┼─────┼──────┼──────┼──────┼─────┤              ├─────┼─────┼────┼────┼─────────┼─────────┤
//    │    │     │ mute │ vold │ volu │     │              │     │ f4  │ f5 │ f6 │ out_usb │ out_ble │
//    ├────┼─────┼──────┼──────┼──────┼─────┤              ├─────┼─────┼────┼────┼─────────┼─────────┤
//    │    │     │ prev │ play │ next │     │              │     │ f1  │ f2 │ f3 │         │ bt_prv  │
//    └────┴─────┴──────┴──────┼──────┼─────┼────┐   ┌─────┼─────┼─────┼────┴────┴─────────┴─────────┘
//                             │      │     │    │   │ f12 │ f11 │ f10 │
//                             └──────┴─────┴────┘   └─────┴─────┴─────┘
  ___   ___     ___              &kp C_BRIGHTNESS_DEC   &kp C_BRIGHTNESS_INC   &kp C_POWER                       ___       &kp F7    &kp F8   &kp F9   ___            &bt BT_NXT
  ___   &none   &kp C_MUTE       &kp C_VOL_DN           &kp C_VOLUME_UP        ___                               ___       &kp F4    &kp F5   &kp F6   &out OUT_USB   &out OUT_BLE
  ___   ___     &kp C_PREVIOUS   &kp C_PLAY_PAUSE       &kp C_NEXT             ___                               ___       &kp F1    &kp F2   &kp F3   ___            &bt BT_PRV
                                                        ___                    ___           ___       &kp F12   &kp F11   &kp F10
           >;

           label = "Function";
       };

       mouse_layer {
           bindings = <
//    ┌────┬──────┬──────┬──────┬──────┬───────┐                   ┌──────┬───────────┬───────────┬───────────┬───────────┬────┐
//    │    │      │      │      │      │       │                   │      │ SCRL_rght │  SCRL_up  │ SCRL_down │ SCRL_left │    │
//    ├────┼──────┼──────┼──────┼──────┼───────┤                   ├──────┼───────────┼───────────┼───────────┼───────────┼────┤
//    │    │ lctl │ lalt │ lsft │ lgui │       │                   │      │ MOVE_left │ MOVE_down │  MOVE_up  │ MOVE_rght │    │
//    ├────┼──────┼──────┼──────┼──────┼───────┤                   ├──────┼───────────┼───────────┼───────────┼───────────┼────┤
//    │    │      │      │      │      │       │                   │      │           │           │           │           │    │
//    └────┴──────┴──────┴──────┼──────┼───────┼────────┐   ┌──────┼──────┼───────────┼───────────┴───────────┴───────────┴────┘
//                              │      │ mo FN │ mo NAV │   │ mclk │ lclk │   rclk    │
//                              └──────┴───────┴────────┘   └──────┴──────┴───────────┘
  ___   ___         ___        ___         ___        ___                               ___        &msc SCRL_RIGHT   &msc SCRL_UP     &msc SCRL_DOWN   &msc SCRL_LEFT    ___
  ___   &kp LCTRL   &kp LALT   &kp LSHFT   &kp LGUI   ___                               ___        &mmv MOVE_LEFT    &mmv MOVE_DOWN   &mmv MOVE_UP     &mmv MOVE_RIGHT   ___
  ___   ___         ___        ___         ___        ___                               ___        ___               ___              ___              ___               ___
                                           ___        &mo FN   &mo NAV       &mkp MB3   &mkp MB1   &mkp MB2
           >;

           label = "Mouse";
       };
   };
};
/*
qmk:json:start
{
  "layout": [
    "x x x x x x _ _ _ x x x x x x",
    "x x x x x x _ _ _ x x x x x x",
    "x x x x x x _ _ _ x x x x x x",
    "_ _ _ _ x x x _ x x x _ _ _ _"
  ],
  "comment_preview": {
    "position": "top",
    "keymap_overrides": {
      "___": "  ",
      "LS(LA(LC(LEFT_GUI)))": "hyper",
      "NON_US_BSLH": "ä",
      "LA(LG(LEFT))": "Prev tab",
      "RG(T)": "New tab",
      "LA(LG(RIGHT))": "Next tab",
      "RG(TAB)": "Switch app",
      "RC(LEFT)": "Prev desktop",
      "RC(RIGHT)": "Next desktop",
      "RG(W)": "Close window",
      "RG(LEFT)": "Prev page",
      "RG(RIGHT)": "Next page",
      "RC(UP)": "Mission Control",
      "LS(LG(F))": "Fullscreen"
    }
  },
  "variant": "zmk"
}
qmk:json:end
*/

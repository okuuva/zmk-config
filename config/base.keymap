#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#ifdef CONFIG_WIRELESS
  #include <dt-bindings/zmk/bt.h>
  #include <dt-bindings/zmk/outputs.h>
#endif

#include "constants.dtsi"
#include "mouse.dtsi"

/* Keymap */

/ {
   keymap {
       compatible = "zmk,keymap";

       base_layer {
           display-name = "Base";
           bindings = <
//    ┌──────────┬────────────┬────────────┬──────────────┬────────────┬──────────────┐   ┌────────────┬────────────┬────────────┬────────────┬────────────┬─────┐
//    │  mo FUN  │     Q      │     Y      │      O       │     U      │      ;       │   │     X      │     L      │     D      │     W      │     Z      │     │
//    ├──────────┼────────────┼────────────┼──────────────┼────────────┼──────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┼─────┤
//    │ lt MOU B │ hml lctl C │ hml lalt I │  hml lsft E  │ hml lgui A │      ,       │   │     K      │ hmr rgui H │ hmr rsft T │ hmr ralt N │ hmr rctl S │  V  │
//    ├──────────┼────────────┼────────────┼──────────────┼────────────┼──────────────┤   ├────────────┼────────────┼────────────┼────────────┼────────────┼─────┤
//    │    ä     │     '      │     /      │      =       │     -      │      .       │   │     J      │     M      │     G      │     P      │     F      │     │
//    └──────────┴────────────┴────────────┼──────────────┼────────────┼──────────────┤   ├────────────┼────────────┼────────────┼────────────┴────────────┴─────┘
//                                         │ mt HYPER tab │ lt NUM spc │ mt HYPER tab │   │ lt SYM esc │  lt NAV R  │ lt SYM esc │
//                                         └──────────────┴────────────┴──────────────┘   └────────────┴────────────┴────────────┘
  &mo FUN     &kp Q          &kp Y         &kp O           &kp U           &kp SEMICOLON       &kp X         &kp L         &kp D          &kp W         &kp Z          &none
  &lt MOU B   &hml LCTRL C   &hml LALT I   &hml LSHFT E    &hml LGUI A     &kp COMMA           &kp K         &hmr RGUI H   &hmr RSHFT T   &hmr RALT N   &hmr RCTRL S   &kp V
  &kp ISO     &kp SQT        &kp SLASH     &kp EQUAL       &kp MINUS       &kp PERIOD          &kp J         &kp M         &kp G          &kp P         &kp F          &none
                                           &mt HYPER TAB   &lt NUM SPACE   &mt HYPER TAB       &lt SYM ESC   &lt NAV R     &lt SYM ESC
           >;
       };

       nav_layer {
           bindings = <
//    ┌──────────┬──────────┬──────────┬───────────┬──────────┬────┐   ┌────────────┬───────┬──────┬──────┬──────┬────┐
//    │          │          │ PrevTab  │  NewTab   │ NextTab  │    │   │            │ home  │ pgdn │ pgup │ end  │    │
//    ├──────────┼──────────┼──────────┼───────────┼──────────┼────┤   ├────────────┼───────┼──────┼──────┼──────┼────┤
//    │          │   caps   │ PrevDesk │ SwitchApp │ NextDesk │    │   │ Fullscreen │ left  │ down │  up  │ rght │    │
//    ├──────────┼──────────┼──────────┼───────────┼──────────┼────┤   ├────────────┼───────┼──────┼──────┼──────┼────┤
//    │ PrevPage │ ShowDesk │ NextPage │ CloseWin  │          │    │   │   again    │ paste │ copy │ cut  │ undo │    │
//    └──────────┴──────────┴──────────┼───────────┼──────────┼────┤   ├────────────┼───────┼──────┼──────┴──────┴────┘
//                                     │           │   bspc   │    │   │            │       │      │
//                                     └───────────┴──────────┴────┘   └────────────┴───────┴──────┘
  ___            ___            &kp PrevTab    &kp NewTab      &kp NextTab    ___       ___              &kp HOME      &kp PG_DN    &kp PG_UP   &kp END      ___
  ___            &kp CAPSLOCK   &kp PrevDesk   &kp SwitchApp   &kp NextDesk   ___       &kp Fullscreen   &kp LEFT      &kp DOWN     &kp UP      &kp RIGHT    ___
  &kp PrevPage   &kp ShowDesk   &kp NextPage   &kp CloseWin    ___            ___       &kp K_REDO       &kp K_PASTE   &kp K_COPY   &kp K_CUT   &kp K_UNDO   ___
                                               ___             &kp BSPC       ___       ___              ___           ___
           >;

           label = "Navigation";
       };

       num_layer {
           bindings = <
//    ┌────┬────────────┬────────────┬────────────┬────────────┬────┐   ┌────┬────────────┬────────────┬────────────┬────────────┬────┐
//    │    │            │            │            │            │    │   │    │            │            │            │            │    │
//    ├────┼────────────┼────────────┼────────────┼────────────┼────┤   ├────┼────────────┼────────────┼────────────┼────────────┼────┤
//    │    │ hml lctl 1 │ hml lalt 2 │ hml lsft 3 │ hml lgui 4 │ 5  │   │ 6  │ hmr rgui 7 │ hmr rsft 8 │ hml ralt 9 │ hml rctl 0 │    │
//    ├────┼────────────┼────────────┼────────────┼────────────┼────┤   ├────┼────────────┼────────────┼────────────┼────────────┼────┤
//    │    │            │            │            │            │    │   │    │            │            │            │            │    │
//    └────┴────────────┴────────────┼────────────┼────────────┼────┤   ├────┼────────────┼────────────┼────────────┴────────────┴────┘
//                                   │            │            │    │   │    │            │            │
//                                   └────────────┴────────────┴────┘   └────┴────────────┴────────────┘
  ___   ___             ___            ___             ___            ___          ___      ___            ___             ___            ___             ___
  ___   &hml LCTRL N1   &hml LALT N2   &hml LSHFT N3   &hml LGUI N4   &kp N5       &kp N6   &hmr RGUI N7   &hmr RSHFT N8   &hml RALT N9   &hml RCTRL N0   ___
  ___   ___             ___            ___             ___            ___          ___      ___            ___             ___            ___             ___
                                       ___             ___            ___          ___      ___            ___
           >;

           label = "Numbers";
       };

       sym_layer {
           bindings = <
//    ┌───┬───┬───┬───┬───┬───┐   ┌────┬──────┬───────────┬─────┬─────┬────┐
//    │ ` │ < │ ( │ ) │ > │ ? │   │ `  │ del  │ lsft(tab) │  -  │  +  │    │
//    ├───┼───┼───┼───┼───┼───┤   ├────┼──────┼───────────┼─────┼─────┼────┤
//    │ # │ ^ │ = │ _ │ $ │ * │   │ "  │ bspc │    tab    │ ent │ spc │    │
//    ├───┼───┼───┼───┼───┼───┤   ├────┼──────┼───────────┼─────┼─────┼────┤
//    │ & │ ~ │ / │ \ │ | │ . │   │ '  │  [   │     {     │  }  │  ]  │    │
//    └───┴───┴───┼───┼───┼───┤   ├────┼──────┼───────────┼─────┴─────┴────┘
//                │ @ │ % │ ! │   │    │      │           │
//                └───┴───┴───┘   └────┴──────┴───────────┘
  &kp GRAVE       &kp LESS_THAN   &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS   &kp GREATER_THAN   &kp QUESTION          &kp GRAVE           &kp DELETE         &kp LS(TAB)      &kp MINUS         &kp PLUS            ___
  &kp HASH        &kp CARET       &kp EQUAL              &kp UNDERSCORE          &kp DOLLAR         &kp ASTERISK          &kp DOUBLE_QUOTES   &kp BACKSPACE      &kp TAB          &kp ENTER         &kp SPACE           ___
  &kp AMPERSAND   &kp TILDE       &kp SLASH              &kp BACKSLASH           &kp PIPE           &kp DOT               &kp SQT             &kp LEFT_BRACKET   &kp LEFT_BRACE   &kp RIGHT_BRACE   &kp RIGHT_BRACKET   ___
                                                         &kp AT_SIGN             &kp PERCENT        &kp EXCLAMATION       ___                 ___                ___
           >;

           label = "Symbols";
       };

       fn_layer {
           bindings = <
//    ┌────────┬─────┬──────┬──────┬──────┬─────┐   ┌─────┬─────┬─────┬────┬──────────┬──────────┐
//    │        │     │      │ bri- │ bri+ │ pwr │   │     │ f7  │ f8  │ f9 │          │  bt_prv  │
//    ├────────┼─────┼──────┼──────┼──────┼─────┤   ├─────┼─────┼─────┼────┼──────────┼──────────┤
//    │        │     │ mute │ vold │ volu │     │   │     │ f4  │ f5  │ f6 │ out_ usb │ out_ ble │
//    ├────────┼─────┼──────┼──────┼──────┼─────┤   ├─────┼─────┼─────┼────┼──────────┼──────────┤
//    │ bt_clr │     │ prev │ play │ next │     │   │     │ f1  │ f2  │ f3 │          │  bt_nxt  │
//    └────────┴─────┴──────┼──────┼──────┼─────┤   ├─────┼─────┼─────┼────┴──────────┴──────────┘
//                          │      │      │     │   │ f12 │ f11 │ f10 │
//                          └──────┴──────┴─────┘   └─────┴─────┴─────┘
  ___          ___     ___              &kp C_BRIGHTNESS_DEC   &kp C_BRIGHTNESS_INC   &kp C_POWER       ___       &kp F7    &kp F8    &kp F9   ___            &bt BT_PRV
  ___          &none   &kp C_MUTE       &kp C_VOL_DN           &kp C_VOLUME_UP        ___               ___       &kp F4    &kp F5    &kp F6   &out OUT_USB   &out OUT_BLE
  &bt BT_CLR   ___     &kp C_PREVIOUS   &kp C_PLAY_PAUSE       &kp C_NEXT             ___               ___       &kp F1    &kp F2    &kp F3   ___            &bt BT_NXT
                                        ___                    ___                    ___               &kp F12   &kp F11   &kp F10
           >;

           label = "Function";
       };

       mouse_layer {
           bindings = <
//    ┌────┬──────┬──────┬──────┬────────┬────────┐   ┌──────┬────────┬────────┬────────┬────────┬────┐
//    │    │      │ rclk │ mclk │  lclk  │        │   │      │ SCRL_R │ SCRL_U │ SCRL_D │ SCRL_L │    │
//    ├────┼──────┼──────┼──────┼────────┼────────┤   ├──────┼────────┼────────┼────────┼────────┼────┤
//    │    │ lctl │ lalt │ lsft │  lgui  │        │   │      │  MS_L  │  MS_D  │  MS_U  │  MS_R  │    │
//    ├────┼──────┼──────┼──────┼────────┼────────┤   ├──────┼────────┼────────┼────────┼────────┼────┤
//    │    │      │      │      │        │        │   │      │        │        │        │        │    │
//    └────┴──────┴──────┼──────┼────────┼────────┤   ├──────┼────────┼────────┼────────┴────────┴────┘
//                       │      │ mo FUN │ mo NAV │   │ mclk │  lclk  │  rclk  │
//                       └──────┴────────┴────────┘   └──────┴────────┴────────┘
  ___   ___         &mkp MB2   &mkp MB3    &mkp MB1   ___           ___        &msc SCRL_R   &msc SCRL_U   &msc SCRL_D   &msc SCRL_L   ___
  ___   &kp LCTRL   &kp LALT   &kp LSHFT   &kp LGUI   ___           ___        &mmv MS_L     &mmv MS_D     &mmv MS_U     &mmv MS_R     ___
  ___   ___         ___        ___         ___        ___           ___        ___           ___           ___           ___           ___
                               ___         &mo FUN    &mo NAV       &mkp MB3   &mkp MB1      &mkp MB2
           >;

           label = "Mouse";
       };
   };
};
/*
qmk:json:start
{
  "layout": [
    "x x x x x x _ x x x x x x",
    "x x x x x x _ x x x x x x",
    "x x x x x x _ x x x x x x",
    "_ _ _ x x x _ x x x _ _ _"
  ],
  "comment_preview": {
    "position": "top",
    "keymap_overrides": {
      "___": "  ",
      "&hml": "hml",
      "&hmr": "hmr",
      "&mmv ": "",
      "&msc ": "",
      "ISO": "ä",
      "K_PASTE": "paste"
    }
  },
  "variant": "zmk"
}
qmk:json:end
*/

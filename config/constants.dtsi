// OS
// https://github.com/urob/zmk-helpers/tree/main?tab=readme-ov-file#unicode-characters-and-language-collection
#define WINDOWS 0
#define LINUX 1
#define MAC_OS 2

#undef COPY
#undef PASTE
#undef CUT
#undef UNDO
#undef REDO
// macOS defaults; Windows mode overrides these bindings in base.keymap.
#define COPY LG(C)
#define PASTE LG(V)
#define CUT LG(X)
#define UNDO LG(Z)
#define REDO LS(LG(Z))
#define LockScreen LC(LG(Q))

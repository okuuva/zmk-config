#define WPASTE LC(V)
#define WCUT LC(X)
#define WUNDO LC(Z)
#define WREDO LC(Y)
#define WLockScreen LG(L)

/* Global defaults */
// See ../readme.md#troubleshooting
#define TAPPING_TERM_MS 200
#define QUICK_TAP_MS 175
#define PRIOR_IDLE_MS 75
#define SHIFT_PRIOR_IDLE_MS 0 // cross-hand shift rolls; other mods keep PRIOR_IDLE_MS

&sk {
  release-after-ms = <900>;
  quick-release;
};

&sl { // Allow sticky mods to chord across sticky layers.
  ignore-modifiers;
};

&lt {
  flavor = "balanced";
  tapping-term-ms = <TAPPING_TERM_MS>;
  quick-tap-ms = <QUICK_TAP_MS>;
};

// Choose on Q press; modifiers added after entering Mouse still work normally.
ZMK_MOD_MORPH(q_mouse,
    bindings = <&lt MOU Q>, <&kp Q>;
    mods = <(MOD_LCTL | MOD_LSFT | MOD_LALT | MOD_LGUI | MOD_RCTL | MOD_RSFT | MOD_RALT | MOD_RGUI)>;
    keep-mods = <(MOD_LCTL | MOD_LSFT | MOD_LALT | MOD_LGUI | MOD_RCTL | MOD_RSFT | MOD_RALT | MOD_RGUI)>;
)

ZMK_CAPS_WORD(caps_word,
    continue-list = <
      UNDERSCORE MINUS
      BACKSPACE
    >;
)

&num_word {
  continue-list = <BSPC DEL DOT COMMA PLUS MINUS STAR FSLH EQUAL COLON>;
};

/ {
    behaviors {
        // num_word tap
        nwt: nwt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <TAPPING_TERM_MS>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <PRIOR_IDLE_MS>;
            bindings = <&kp>, <&num_word>;
        };
        // caps_word tap
        cwt: cwt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <TAPPING_TERM_MS>;
            quick-tap-ms = <QUICK_TAP_MS>;
            require-prior-idle-ms = <PRIOR_IDLE_MS>;
            bindings = <&kp>, <&caps_word>;
        };
    };
    macros {
        // <3
        lt3: lt3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_tap &kp LESS_THAN &kp N3 >
                ;
        };
    };
};
/* Homerow mods */

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R RT0 RT1 RT2 RT3 RT4 LT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2 // Thumbs on 36+ keys.

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS) \
  ZMK_HOLD_TAP(NAME, \
    bindings = <HOLD>, <TAP>; \
    flavor = "balanced"; \
    tapping-term-ms = <TAPPING_TERM_MS>; \
    quick-tap-ms = <QUICK_TAP_MS>; \
    require-prior-idle-ms = <PRIOR_IDLE_MS>; \
    hold-trigger-on-release; \
    hold-trigger-key-positions = <TRIGGER_POS>; \
  )

MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS) // Left-hand HRMs.
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS) // Right-hand HRMs.

#define MAKE_HRM_SHIFT(NAME, HOLD, TAP, TRIGGER_POS) \
  ZMK_HOLD_TAP(NAME, \
    bindings = <HOLD>, <TAP>; \
    flavor = "balanced"; \
    tapping-term-ms = <TAPPING_TERM_MS>; \
    quick-tap-ms = <QUICK_TAP_MS>; \
    require-prior-idle-ms = <SHIFT_PRIOR_IDLE_MS>; \
    hold-trigger-on-release; \
    hold-trigger-key-positions = <TRIGGER_POS>; \
  )

MAKE_HRM_SHIFT(hmls, &kp, &kp, KEYS_R THUMBS) // Left-hand shift HRMs.
MAKE_HRM_SHIFT(hmrs, &kp, &kp, KEYS_L THUMBS) // Right-hand shift HRMs.

/*                     KEY POSITIONS

  ╭─────────────────────────╮ ╭─────────────────────────╮
  │ LT5 LT4 LT3 LT2 LT1 LT0 │ │ RT0 RT1 RT2 RT3 RT4 RT5 │
  │ LM5 LM4 LM3 LM2 LM1 LM0 │ │ RM0 RM1 RM2 RM3 RM4 RM5 │
  │ LB5 LB4 LB3 LB2 LB1 LB0 │ │ RB0 RB1 RB2 RB3 RB4 RB5 │
  ╰───────╮     LH2 LH1 LH0 │ │ RH0 RH1 RH2 ╭───────────╯
          ╰─────────────────╯ ╰─────────────╯ */

ZMK_COMBO(enter, &kp ENTER, RM1 RM2 RM3, ALL, 50, 75)

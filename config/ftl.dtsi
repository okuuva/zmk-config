// FTL-only behaviors. Ordinary typing behaviors retain their existing timings.
// ponytail: no delayed typing macros during FTL play; recheck queue ordering if added.
#define FTL_LEFT LT5 LT4 LT3 LT2 LT1 LT0 LM5 LM4 LM3 LM2 LM1 LM0 LB5 LB4 LB3 LB2 LB1 LB0 LH2 LH1 LH0
#define FTL_VIEWS FTL FTL_POWER FTL_WEAPONS FTL_UTILITIES

// Pulse a transparent signal layer to end the active FTL tri-state, not just its map.
ZMK_MACRO(ftl_cancel,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&mo FTL_CANCEL>;
)
// Queue the output after the cancellation pulse's cleanup, even behind other macros.
ZMK_MACRO_ONE_PARAM(ftl_key,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;
)
ZMK_MACRO(ftl_pause,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&mo FTL_CANCEL &ftl_key FTL_PAUSE>;
)
ZMK_MACRO(ftl_battery,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&mo FTL_CANCEL &ftl_key FTL_BATTERY>;
)
ZMK_MACRO(ftl_toggle,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&tog FTL>;
)
ZMK_MACRO(ftl_leave,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&mo FTL_CANCEL &ftl_toggle>;
)
ZMK_TAP_DANCE(ftl_exit,
    tapping-term-ms = <200>;
    bindings = <&none>, <&ftl_leave>;
)
ZMK_TAP_DANCE(ftl_save,
    tapping-term-ms = <200>;
    bindings = <&none>, <&ftl_key FTL_SAVE_CREW>;
)

ZMK_MACRO(ftl_systems_on,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&macro_press &mo FTL_POWER>;
)
ZMK_MACRO(ftl_systems_off,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&macro_release &mo FTL_POWER>;
)
ZMK_MACRO(ftl_depower_on,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&macro_press &kp LSHFT &mo FTL_POWER>;
)
ZMK_MACRO(ftl_depower_off,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&macro_release &mo FTL_POWER &kp LSHFT>;
)
ZMK_MACRO(ftl_weapons_on,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&macro_press &kp LSHFT &mo FTL_WEAPONS>;
)
ZMK_MACRO(ftl_weapons_off,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&macro_release &mo FTL_WEAPONS &kp LSHFT>;
)
ZMK_MACRO(ftl_utilities_on,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&macro_press &mo FTL_UTILITIES>;
)
ZMK_MACRO(ftl_utilities_off,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&macro_release &mo FTL_UTILITIES>;
)

// TODO: fix tri-state deadline rescheduling, slot reuse, and ignored-key hold counting.
// ponytail: Q31 accepts these timer limits; retain explicit Cancel/Pause recovery.
ZMK_TRI_STATE(ftl_systems,
    bindings = <&ftl_systems_on>, <&none>, <&ftl_systems_off>;
    ignored-key-positions = <FTL_LEFT>;
    ignored-layers = <FTL_VIEWS FTL_WEAPONS_END FTL_UTILITIES_END>;
    timeout-ms = <600>; tap-ms = <0>;
)
ZMK_TRI_STATE(ftl_depower,
    bindings = <&ftl_depower_on>, <&none>, <&ftl_depower_off>;
    ignored-key-positions = <FTL_LEFT>;
    ignored-layers = <FTL_VIEWS FTL_WEAPONS_END FTL_UTILITIES_END>;
    timeout-ms = <600>; tap-ms = <0>;
)
ZMK_TRI_STATE(ftl_weapons,
    bindings = <&ftl_weapons_on>, <&none>, <&ftl_weapons_off>;
    ignored-key-positions = <FTL_LEFT>;
    ignored-layers = <FTL_VIEWS FTL_UTILITIES_END>;
    tap-ms = <0>;
)
ZMK_TRI_STATE(ftl_utilities,
    bindings = <&ftl_utilities_on>, <&none>, <&ftl_utilities_off>;
    ignored-key-positions = <FTL_LEFT>;
    ignored-layers = <FTL_VIEWS FTL_WEAPONS_END>;
    tap-ms = <0>;
)

ZMK_MACRO(ftl_select_minus,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&mo FTL_CANCEL &ftl_depower>;
)
ZMK_MACRO(ftl_select_plus,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&mo FTL_CANCEL &ftl_systems>;
)
// Each hold has its own release signal, ignored by all other FTL modes.
// A cancelled hold's later release therefore cannot end a newer mode.
ZMK_MACRO(ftl_weapons_hold,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&mo FTL_CANCEL>, <&macro_press &ftl_weapons>,
               <&macro_pause_for_release>,
               <&macro_tap &mo FTL_WEAPONS_END>, <&macro_release &ftl_weapons>;
)
ZMK_MACRO(ftl_utilities_hold,
    wait-ms = <0>; tap-ms = <0>;
    bindings = <&mo FTL_CANCEL>, <&macro_press &ftl_utilities>,
               <&macro_pause_for_release>,
               <&macro_tap &mo FTL_UTILITIES_END>, <&macro_release &ftl_utilities>;
)
// Let thumb-first release rolls select Systems instead of the held view.
ZMK_HOLD_TAP(ftl_minus,
    flavor = "balanced"; tapping-term-ms = <200>;
    bindings = <&ftl_weapons_hold>, <&ftl_select_minus>;
)
ZMK_HOLD_TAP(ftl_plus,
    flavor = "balanced"; tapping-term-ms = <200>;
    bindings = <&ftl_utilities_hold>, <&ftl_select_plus>;
)

// Only this key's own position may select hold on interruption: other keys force tap.
// Without another downstroke, the timer still selects hold normally.
ZMK_HOLD_TAP(ftl_autofire,
    flavor = "hold-preferred"; tapping-term-ms = <150>;
    hold-trigger-key-positions = <LT4>;
    bindings = <&kp>, <&ftl_key>;
)
ZMK_HOLD_TAP(ftl_teleport,
    flavor = "hold-preferred"; tapping-term-ms = <150>;
    hold-trigger-key-positions = <LB1>;
    bindings = <&ftl_key>, <&ftl_key>;
)

ZMK_COMBO(ftl_open, &kp FTL_OPEN_DOORS, LM4 LM3, FTL, 30)
ZMK_COMBO(ftl_close, &kp FTL_CLOSE_DOORS, LM3 LM2, FTL, 30)
ZMK_COMBO(ftl_jump, &kp FTL_JUMP, LM2 LM1, FTL, 30)
